DATABASE_URL=postgresql://auction:auction@localhost:5432/auction
REDIS_URL=redis://localhost:6379
AUTH_SECRET=change-me-to-a-random-string-of-32-chars-or-more
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
AUTH_URL=http://localhost:3000
TYPESENSE_URL=http://localhost:8108
TYPESENSE_API_KEY=auction-dev-key
# Photos use Vercel Blob with OIDC, so there is no token to put here. Run `npx vercel link`, then
# `npx vercel env pull apps/web/.env.local` to fetch BLOB_STORE_ID, BLOB_WEBHOOK_PUBLIC_KEY and VERCEL_OIDC_TOKEN.
# Email. Leave RESEND_API_KEY empty in development: codes and links print in the API log instead.
RESEND_API_KEY=
MAIL_FROM=
