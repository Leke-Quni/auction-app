DATABASE_URL=postgresql://auction:auction@localhost:5432/auction
REDIS_URL=redis://localhost:6379
AUTH_SECRET=change-me-to-a-random-string-of-32-chars-or-more
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
# The API address as the browser reaches it, for the live WebSocket.
NEXT_PUBLIC_API_URL=http://localhost:4000
AUTH_URL=http://localhost:3000
TYPESENSE_URL=http://localhost:8108
TYPESENSE_API_KEY=auction-dev-key
# Photos use Vercel Blob with OIDC, so there is no token to put here. Run `npx vercel link`, then
# `npx vercel env pull apps/web/.env.local` to fetch BLOB_STORE_ID, BLOB_WEBHOOK_PUBLIC_KEY and VERCEL_OIDC_TOKEN.
# Email. Leave RESEND_API_KEY empty in development: codes and links print in the API log instead.
RESEND_API_KEY=
# Or send through Gmail SMTP (no domain needed; SMTP_PASS is a Google app password). SMTP wins when both are set.
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Payments. Leave both empty to use the in-memory fake provider. With Stripe test keys set, buyers pay on Stripe's hosted page.
# Locally, `stripe listen --forward-to localhost:4000/payments/stripe/webhook` prints the whsec_ value for STRIPE_WEBHOOK_SECRET.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# With the keys above, sellers' payouts are still simulated (set up in one click, no Stripe page). Set true for real Stripe Connect payouts.
STRIPE_PAYOUTS=
# Scheduled jobs. With all four set, QStash calls the API at the moment an auction ends or an unpaid order's payment window runs
# out (and wakes a stopped Fly machine); without them the sweeps alone do the work, a few seconds later. API_PUBLIC_URL is the
# address QStash can reach the API at (the Fly URL, or a tunnel locally). Token and both signing keys are on the QStash page of
# the Upstash console. Locally, `npx @upstash/qstash-cli dev` runs a QStash server that prints QSTASH_URL (http://localhost:8080),
# the token and the keys, and needs no account; set QSTASH_URL too and use API_PUBLIC_URL=http://localhost:4000.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
API_PUBLIC_URL=
QSTASH_URL=
# Delivery the buyer pays on top of the price (the platform pays the carriers): PERCENT of the item price, between MIN and MAX cents, plus the chosen option's extra.
# Defaults: 5, 300, 5000. The seller fee cap is PLATFORM_FEE_CAP_CENTS (default 5000).
DELIVERY_PERCENT=
DELIVERY_MIN_CENTS=
DELIVERY_MAX_CENTS=
