{
  "$schema": "https://turborepo.com/schema.json",
  "globalPassThroughEnv": ["DATABASE_URL", "REDIS_URL", "AUTH_SECRET", "AUTH_URL", "WEB_URL", "API_URL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
