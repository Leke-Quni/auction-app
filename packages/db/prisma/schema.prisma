generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  firstName           String
  lastName            String
  username            String               @unique
  passwordHash        String
  emailVerified       DateTime?
  role                Role                 @default(USER)
  // Set by an admin: the person cannot sign in or use the API. Checked on every request, so it takes effect at once.
  bannedAt            DateTime?
  banReason           String?
  // The seller's default pickup address and contact; each listing starts from it and may change it.
  pickupAddress       Json?
  // The seller's connected payment account at the payment provider, created when they first ask to get paid.
  payoutAccountId     String?             @unique
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  loginCodes          LoginCode[]
  passwordResetTokens PasswordResetToken[]
  emailChange         EmailChange?
  listings            Listing[]            @relation("ListingSeller")
  leadingListings     Listing[]            @relation("ListingHighBidder")
  wonListings         Listing[]            @relation("ListingWinner")
  strikes             Strike[]
  purchases           Order[]              @relation("OrderBuyer")
  sales               Order[]              @relation("OrderSeller")
  bids                Bid[]
  notifications       Notification[]
  watches             Watch[]
  ratingsGiven        Rating[]             @relation("RatingBuyer")
  ratingsReceived     Rating[]             @relation("RatingSeller")
  questions           Question[]
  questionVotes       QuestionVote[]
}

model LoginCode {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model EmailChange {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  newEmail  String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
}

enum ListingCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  POOR
}

enum ListingStatus {
  DRAFT
  PUBLISHED
}

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  sortOrder Int
  listings  Listing[]
}

model Listing {
  id                 String           @id @default(cuid())
  sellerId           String
  seller             User             @relation("ListingSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  title              String
  description        String
  categoryId         String
  category           Category         @relation(fields: [categoryId], references: [id])
  condition          ListingCondition
  startingPriceCents Int
  reservePriceCents  Int?
  durationDays       Int
  // Where our carrier collects the item (the seller's name, address and phone). Required to publish, fixed after, and
  // never sent to buyers. Chosen per listing, starting from the seller's default (User.pickupAddress).
  pickupAddress      Json?
  status             ListingStatus    @default(DRAFT)
  startsAt           DateTime?
  endsAt             DateTime?
  publishedAt        DateTime?
  // Kept in step with the bids by the bid transaction, so a page never has to add them up.
  currentBidCents    Int?
  bidCount           Int              @default(0)
  // How many times a late bid has extended this auction (see ANTI_SNIPING in packages/shared).
  extensionCount     Int              @default(0)
  highBidderId       String?
  highBidder         User?            @relation("ListingHighBidder", fields: [highBidderId], references: [id], onDelete: Restrict)
  // Set once, when the auction is closed after its end time (slice 5). `outcome` says how it ended; `winnerId` and
  // `finalPriceCents` are only set for a sale.
  closedAt           DateTime?
  outcome            ListingOutcome?
  winnerId           String?
  winner             User?            @relation("ListingWinner", fields: [winnerId], references: [id], onDelete: Restrict)
  finalPriceCents    Int?
  // Set when an admin took the auction down: it ends at that moment with no sale (`outcome` NO_SALE, or NO_BIDS when nobody
  // had bid) and cannot be listed again. `removedById` is a plain column, not a relation, so the record outlives the admin.
  removedAt          DateTime?
  removedById        String?
  removalReason      String?
  // Set on a draft made by "list it again", so asking again returns that draft instead of making another. A plain column,
  // not a relation: the old listing is only a record to copy from.
  relistedFromId     String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  images             ListingImage[]
  bids               Bid[]
  notifications      Notification[]
  questions          Question[]
  orders             Order[]
  watches            Watch[]

  @@index([status, endsAt])
  @@index([sellerId])
  @@index([categoryId])
  @@index([highBidderId])
  @@index([winnerId])
  @@index([status, closedAt, endsAt])
  @@index([relistedFromId])
}

// A listing a user keeps an eye on. Gone with the user or the listing; the "ending soon" email owed for it is a
// PendingEndEmail row, removed when the watch is.
model Watch {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, listingId])
  @@index([listingId])
}

enum OrderStatus {
  AWAITING_PAYMENT
  PAID
  EXPIRED
  CANCELLED
}

// A sale: what the winner owes and until when. `feeCents` is the platform's share, taken from the seller; the seller
// is paid `sellerNetCents` (released in slice 6). `round` counts the people the item was offered to (1 for the winner).
model Order {
  id             String      @id @default(cuid())
  listingId      String
  listing        Listing     @relation(fields: [listingId], references: [id], onDelete: Restrict)
  buyerId        String
  buyer          User        @relation("OrderBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  sellerId       String
  seller         User        @relation("OrderSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  amountCents    Int
  feeCents       Int
  sellerNetCents Int
  status         OrderStatus @default(AWAITING_PAYMENT)
  round          Int         @default(1)
  payBy          DateTime
  // Set when the "24 hours left to pay" reminder has gone out, so the buyer gets it once.
  payReminderSentAt DateTime?
  // A sweep that is sending the reminder holds this lease; if the machine stops before it finishes, the lease runs out and the
  // next sweep sends it, so the reminder is delayed and never lost.
  payReminderClaimedAt DateTime?
  paidAt         DateTime?
  // The payment provider's checkout session for the latest attempt to pay.
  paymentRef     String?
  // Every checkout session started for this order, so a payment on an earlier attempt is still found.
  paymentRefs    String[]    @default([])
  // Delivery details the buyer chose before paying: the address and the carrier's option (both validated by the shared
  // schemas), its price, and the total charged (amountCents + shippingCents). All null until chosen.
  shippingAddress Json?
  shippingOption  Json?
  shippingCents   Int?
  totalCents      Int?
  // A copy of the listing's pickup address taken when the sale closes, for the carrier.
  pickupAddress   Json?
  // Assigned once, when the order becomes PAID (from the InvoiceNumberSeq sequence), as INV-<year>-<number>.
  invoiceNumber   String?     @unique
  // Set when the seller marks a paid order shipped; the fake carrier then moves it on. Null until shipped.
  // Whether the buyer asked, when choosing delivery, for emails about the parcel's progress. Off unless ticked.
  trackingEmails  Boolean     @default(false)
  shipmentStatus  ShipmentStatus?
  trackingCode    String?
  shippedAt       DateTime?
  inTransitAt     DateTime?
  deliveredAt     DateTime?
  payout          Payout?
  rating          Rating?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([listingId, round])
  @@index([buyerId])
  @@index([sellerId])
  @@index([status, payBy])
  @@index([shipmentStatus])
}

// What a buyer thought of the seller after a delivered order: one per order, never changed. The stars are checked 1 to 5 by the
// database (see the migration).
model Rating {
  id        String   @id @default(cuid())
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  buyerId   String
  buyer     User     @relation("RatingBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  sellerId  String
  seller    User     @relation("RatingSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  stars     Int
  comment   String?
  createdAt DateTime @default(now())

  @@index([sellerId, createdAt(sort: Desc)])
}

// A seller's share of a delivered order, paid out through the PaymentProvider. One row per order, written only once the
// money has gone; `reference` is the provider's id for the transfer.
model Payout {
  id          String   @id @default(cuid())
  orderId     String   @unique
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  sellerId    String
  amountCents Int
  reference   String
  paidAt      DateTime @default(now())

  @@index([sellerId])
}

enum ShipmentStatus {
  LABEL_CREATED
  IN_TRANSIT
  DELIVERED
}

enum ListingOutcome {
  SOLD
  NO_SALE
  NO_BIDS
}

model ListingImage {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  pathname  String
  position  Int
  createdAt DateTime @default(now())

  @@unique([listingId, position])
}

// Every accepted bid. The unique key makes a retry harmless: the same bidder and key never place two bids.
model Bid {
  id             String   @id @default(cuid())
  listingId      String
  listing        Listing  @relation(fields: [listingId], references: [id], onDelete: Restrict)
  bidderId       String
  bidder         User     @relation(fields: [bidderId], references: [id], onDelete: Restrict)
  amountCents    Int
  idempotencyKey String
  ip             String?
  createdAt      DateTime @default(now())

  @@unique([bidderId, idempotencyKey])
  @@index([listingId, amountCents(sort: Desc)])
  @@index([bidderId])
}

enum BidOutcome {
  ACCEPTED
  REFUSED
}

// One row per bid attempt, accepted or refused, with who and from where. Plain ids and no relations, so deleting a
// listing or an account never erases the record.
model BidAudit {
  id          String     @id @default(cuid())
  userId      String?
  listingId   String?
  amountCents Int?
  ip          String?
  outcome     BidOutcome
  reason      String?
  createdAt   DateTime   @default(now())

  @@index([userId, createdAt])
  @@index([listingId, createdAt])
  @@index([ip, createdAt])
}

// An outbid email waiting to be sent, one per person and auction. Waiting lets a bidding war collapse into one email
// (or none, if they bid again or are watching); bidding again deletes the row. Plain ids and no relations, like BidAudit; a sweeper sends what is due.
model PendingOutbidEmail {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  dueAt     DateTime
  // How many times a send has been started. A send claims the row by moving dueAt out (a lease) and deletes it only
  // once the email has gone, so a failed or interrupted send is tried again.
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
  @@index([dueAt])
}

// The "auction ended, you did not win" email a bidder is owed, one per person and auction. It is written in the same
// transaction that closes the auction, so closing and owing the emails cannot come apart, and a sweeper sends what is
// due with the same lease as PendingOutbidEmail. Plain ids and no relations.
model PendingEndEmail {
  id        String       @id @default(cuid())
  userId    String
  listingId String
  kind      EndEmailKind @default(LOST)
  dueAt     DateTime @default(now())
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([userId, listingId, kind])
  @@index([dueAt])
}

// LOST: "the auction ended, you did not win". WON: "you won, pay now".
enum EndEmailKind {
  LOST
  WON
  // When a buyer did not pay in time: the non-payer's notice with their strike count, and the seller's account of what
  // happened next (offered to the next bidder, or no sale).
  EXPIRED
  NOT_PAID
  // After payment: the buyer's confirmation with the invoice, and the seller's "sold, ship to" notice.
  PAID
  SOLD
  // Shipping updates for the buyer.
  SHIPPED
  IN_TRANSIT
  DELIVERED
  // The seller's share has been paid out.
  PAYOUT
  // A watched auction ends in about 24 hours.
  ENDING_SOON
}

enum NotificationType {
  OUTBID
  AUCTION_EXTENDED
  QUESTION_ASKED
  QUESTION_ANSWERED
  // "You won" or "the item is yours to pay for": links to the order to pay.
  WON
}

// What a person can read later in the bell: each notice the API pushes live is saved here too. `key` says what the
// notification is about, and a newer one with the same key replaces the older, so a bidding war leaves one row.
model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  type      NotificationType
  key       String
  title     String
  // The same payload the live notice carried, for showing the details.
  data      Json
  readAt    DateTime?
  createdAt DateTime         @default(now())
  expiresAt DateTime

  @@unique([userId, key])
  @@index([userId, createdAt(sort: Desc)])
  @@index([expiresAt])
}

// A public question on a listing, with the seller's answer once there is one. A deleted question stays as a gap
// (deletedAt set) so the page can say it was deleted, and its text is not shown.
model Question {
  id         String    @id @default(cuid())
  listingId  String
  listing    Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  // Null once the asker's account is gone: the question stays for the seller's answer, but its text is no longer shown.
  askerId    String?
  asker      User?     @relation(fields: [askerId], references: [id], onDelete: SetNull)
  body       String
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?
  answer     String?
  answeredAt DateTime?
  // Set when the asker changes their question or the seller changes their answer.
  editedAt       DateTime?
  answerEditedAt DateTime?

  votes QuestionVote[]

  @@index([listingId, createdAt(sort: Desc)])
  @@index([askerId])
}

enum ReportReason {
  SPAM
  ABUSE
  CONTACT_DETAILS
  OTHER
}

enum ReportStatus {
  OPEN
  HANDLED
}

// A question or answer someone reported, or that the site flagged itself for sharing an email address or phone number.
// It keeps the words as they were and has no foreign keys, so it outlives the post, the listing and the accounts until a
// moderator has dealt with it. The admin app (slice 6) works through the OPEN ones.
model Report {
  id         String       @id @default(cuid())
  questionId String
  listingId  String
  target     VoteTarget
  // Null for a report the site raised itself.
  reporterId String?
  reason     ReportReason
  // When the reported post was written (the question's creation, or the answer's answeredAt), so a replacement answer can be
  // reported again by someone who reported the one before it.
  postedAt   DateTime     @default(now())
  body       String
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())
  handledAt  DateTime?

  @@unique([questionId, target, reporterId, postedAt])
  @@index([status, createdAt])
  @@index([listingId])
}

enum QuestionLogAction {
  CREATED
  EDITED
  DELETED
}

// Every question and answer as it was written, every edit (with the text before it) and every deletion, kept for the
// admin app. It has no foreign keys on purpose: the record outlives the question, the listing and the account.
model QuestionLog {
  id           String            @id @default(cuid())
  questionId   String
  listingId    String
  target       VoteTarget
  action       QuestionLogAction
  actorId      String?
  // The text after the change (for a deletion, the text that was deleted).
  body         String
  previousBody String?
  createdAt    DateTime          @default(now())

  @@index([questionId, createdAt])
  @@index([listingId, createdAt])
  @@index([actorId, createdAt])
}

enum VoteTarget {
  QUESTION
  ANSWER
}

// A like (liked) or dislike (not liked) on a question or on its answer. One per person and target; changing a vote
// rewrites the row and taking it back deletes it.
model QuestionVote {
  id         String     @id @default(cuid())
  questionId String
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  target     VoteTarget
  liked      Boolean
  createdAt  DateTime   @default(now())

  @@unique([questionId, userId, target])
  @@index([userId])
}

// A mark against a buyer who won an auction and did not pay within the payment window. One per expired order (`orderId`
// is unique, so however often the expiry runs a missed payment counts once). Strikes never expire; an admin removes them
// (slice 6). Two strikes block bidding (`MAX_STRIKES` in packages/shared).
model Strike {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  orderId   String   @unique
  createdAt DateTime @default(now())

  @@index([userId])
}

// What admins did: one row per ban, restore, strike cleared, listing removed and order opened (it holds both addresses).
// No foreign keys on purpose, like QuestionLog: the record outlives the account and the listing. Kept for ever.
model AdminAction {
  id        String           @id @default(cuid())
  adminId   String
  action    AdminActionKind
  targetId  String
  // The reason an admin typed, when there was one.
  reason    String?
  createdAt DateTime         @default(now())

  @@index([adminId, createdAt])
  @@index([targetId, createdAt])
  @@index([createdAt])
}

enum AdminActionKind {
  BAN_USER
  UNBAN_USER
  CLEAR_STRIKE
  REMOVE_LISTING
  VIEW_ORDER
}
