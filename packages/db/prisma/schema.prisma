generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  firstName           String
  lastName            String
  username            String               @unique
  passwordHash        String
  emailVerified       DateTime?
  role                Role                 @default(USER)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  loginCodes          LoginCode[]
  passwordResetTokens PasswordResetToken[]
  emailChange         EmailChange?
  listings            Listing[]            @relation("ListingSeller")
  leadingListings     Listing[]            @relation("ListingHighBidder")
  bids                Bid[]
  notifications       Notification[]
  questions           Question[]
  questionVotes       QuestionVote[]
}

model LoginCode {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model EmailChange {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  newEmail  String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
}

enum ListingCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  POOR
}

enum ListingStatus {
  DRAFT
  PUBLISHED
}

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  sortOrder Int
  listings  Listing[]
}

model Listing {
  id                 String           @id @default(cuid())
  sellerId           String
  seller             User             @relation("ListingSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  title              String
  description        String
  categoryId         String
  category           Category         @relation(fields: [categoryId], references: [id])
  condition          ListingCondition
  startingPriceCents Int
  reservePriceCents  Int?
  durationDays       Int
  status             ListingStatus    @default(DRAFT)
  startsAt           DateTime?
  endsAt             DateTime?
  publishedAt        DateTime?
  // Kept in step with the bids by the bid transaction, so a page never has to add them up.
  currentBidCents    Int?
  bidCount           Int              @default(0)
  // How many times a late bid has extended this auction (see ANTI_SNIPING in packages/shared).
  extensionCount     Int              @default(0)
  highBidderId       String?
  highBidder         User?            @relation("ListingHighBidder", fields: [highBidderId], references: [id], onDelete: Restrict)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  images             ListingImage[]
  bids               Bid[]
  notifications      Notification[]
  questions          Question[]

  @@index([status, endsAt])
  @@index([sellerId])
  @@index([categoryId])
  @@index([highBidderId])
}

model ListingImage {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  pathname  String
  position  Int
  createdAt DateTime @default(now())

  @@unique([listingId, position])
}

// Every accepted bid. The unique key makes a retry harmless: the same bidder and key never place two bids.
model Bid {
  id             String   @id @default(cuid())
  listingId      String
  listing        Listing  @relation(fields: [listingId], references: [id], onDelete: Restrict)
  bidderId       String
  bidder         User     @relation(fields: [bidderId], references: [id], onDelete: Restrict)
  amountCents    Int
  idempotencyKey String
  ip             String?
  createdAt      DateTime @default(now())

  @@unique([bidderId, idempotencyKey])
  @@index([listingId, amountCents(sort: Desc)])
  @@index([bidderId])
}

enum BidOutcome {
  ACCEPTED
  REFUSED
}

// One row per bid attempt, accepted or refused, with who and from where. Plain ids and no relations, so deleting a
// listing or an account never erases the record.
model BidAudit {
  id          String     @id @default(cuid())
  userId      String?
  listingId   String?
  amountCents Int?
  ip          String?
  outcome     BidOutcome
  reason      String?
  createdAt   DateTime   @default(now())

  @@index([userId, createdAt])
  @@index([listingId, createdAt])
  @@index([ip, createdAt])
}

// An outbid email waiting to be sent, one per person and auction. Waiting lets a bidding war collapse into one email
// (or none, if they bid again or are watching); bidding again deletes the row. Plain ids and no relations, like BidAudit; a sweeper sends what is due.
model PendingOutbidEmail {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  dueAt     DateTime
  // How many times a send has been started. A send claims the row by moving dueAt out (a lease) and deletes it only
  // once the email has gone, so a failed or interrupted send is tried again.
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
  @@index([dueAt])
}

enum NotificationType {
  OUTBID
  AUCTION_EXTENDED
  QUESTION_ASKED
  QUESTION_ANSWERED
}

// What a person can read later in the bell: each notice the API pushes live is saved here too. `key` says what the
// notification is about, and a newer one with the same key replaces the older, so a bidding war leaves one row.
model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  type      NotificationType
  key       String
  title     String
  // The same payload the live notice carried, for showing the details.
  data      Json
  readAt    DateTime?
  createdAt DateTime         @default(now())
  expiresAt DateTime

  @@unique([userId, key])
  @@index([userId, createdAt(sort: Desc)])
  @@index([expiresAt])
}

// A public question on a listing, with the seller's answer once there is one. A deleted question stays as a gap
// (deletedAt set) so the page can say it was deleted, and its text is not shown.
model Question {
  id         String    @id @default(cuid())
  listingId  String
  listing    Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  // Null once the asker's account is gone: the question stays for the seller's answer, but its text is no longer shown.
  askerId    String?
  asker      User?     @relation(fields: [askerId], references: [id], onDelete: SetNull)
  body       String
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?
  answer     String?
  answeredAt DateTime?
  // Set when the asker changes their question or the seller changes their answer.
  editedAt       DateTime?
  answerEditedAt DateTime?

  votes QuestionVote[]

  @@index([listingId, createdAt(sort: Desc)])
  @@index([askerId])
}

enum ReportReason {
  SPAM
  ABUSE
  CONTACT_DETAILS
  OTHER
}

enum ReportStatus {
  OPEN
  HANDLED
}

// A question or answer someone reported, or that the site flagged itself for sharing an email address or phone number.
// It keeps the words as they were and has no foreign keys, so it outlives the post, the listing and the accounts until a
// moderator has dealt with it. The admin app (slice 6) works through the OPEN ones.
model Report {
  id         String       @id @default(cuid())
  questionId String
  listingId  String
  target     VoteTarget
  // Null for a report the site raised itself.
  reporterId String?
  reason     ReportReason
  body       String
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())
  handledAt  DateTime?

  @@unique([questionId, target, reporterId])
  @@index([status, createdAt])
  @@index([listingId])
}

enum QuestionLogAction {
  CREATED
  EDITED
  DELETED
}

// Every question and answer as it was written, every edit (with the text before it) and every deletion, kept for the
// admin app. It has no foreign keys on purpose: the record outlives the question, the listing and the account.
model QuestionLog {
  id           String            @id @default(cuid())
  questionId   String
  listingId    String
  target       VoteTarget
  action       QuestionLogAction
  actorId      String?
  // The text after the change (for a deletion, the text that was deleted).
  body         String
  previousBody String?
  createdAt    DateTime          @default(now())

  @@index([questionId, createdAt])
  @@index([listingId, createdAt])
  @@index([actorId, createdAt])
}

enum VoteTarget {
  QUESTION
  ANSWER
}

// A like (liked) or dislike (not liked) on a question or on its answer. One per person and target; changing a vote
// rewrites the row and taking it back deletes it.
model QuestionVote {
  id         String     @id @default(cuid())
  questionId String
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  target     VoteTarget
  liked      Boolean
  createdAt  DateTime   @default(now())

  @@unique([questionId, userId, target])
  @@index([userId])
}
