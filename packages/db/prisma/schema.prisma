generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  firstName           String
  lastName            String
  username            String               @unique
  passwordHash        String
  emailVerified       DateTime?
  role                Role                 @default(USER)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  loginCodes          LoginCode[]
  passwordResetTokens PasswordResetToken[]
  emailChange         EmailChange?
  listings            Listing[]
}

model LoginCode {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model EmailChange {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  newEmail  String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
}

enum ListingCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  FOR_PARTS
}

enum ListingStatus {
  DRAFT
  PUBLISHED
}

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  sortOrder Int
  listings  Listing[]
}

model Listing {
  id                 String           @id @default(cuid())
  sellerId           String
  seller             User             @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  title              String
  description        String
  categoryId         String
  category           Category         @relation(fields: [categoryId], references: [id])
  condition          ListingCondition
  startingPriceCents Int
  reservePriceCents  Int?
  durationDays       Int
  status             ListingStatus    @default(DRAFT)
  startsAt           DateTime?
  endsAt             DateTime?
  publishedAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  images             ListingImage[]

  @@index([status, endsAt])
  @@index([sellerId])
  @@index([categoryId])
}

model ListingImage {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  pathname  String
  position  Int
  createdAt DateTime @default(now())

  @@unique([listingId, position])
}
