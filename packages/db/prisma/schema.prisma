generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  firstName           String
  lastName            String
  username            String               @unique
  passwordHash        String
  emailVerified       DateTime?
  role                Role                 @default(USER)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  loginCodes          LoginCode[]
  passwordResetTokens PasswordResetToken[]
  emailChange         EmailChange?
  listings            Listing[]            @relation("ListingSeller")
  leadingListings     Listing[]            @relation("ListingHighBidder")
  bids                Bid[]
}

model LoginCode {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model EmailChange {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  newEmail  String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
}

enum ListingCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  POOR
}

enum ListingStatus {
  DRAFT
  PUBLISHED
}

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  sortOrder Int
  listings  Listing[]
}

model Listing {
  id                 String           @id @default(cuid())
  sellerId           String
  seller             User             @relation("ListingSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  title              String
  description        String
  categoryId         String
  category           Category         @relation(fields: [categoryId], references: [id])
  condition          ListingCondition
  startingPriceCents Int
  reservePriceCents  Int?
  durationDays       Int
  status             ListingStatus    @default(DRAFT)
  startsAt           DateTime?
  endsAt             DateTime?
  publishedAt        DateTime?
  // Kept in step with the bids by the bid transaction, so a page never has to add them up.
  currentBidCents    Int?
  bidCount           Int              @default(0)
  // How many times a late bid has extended this auction (see ANTI_SNIPING in packages/shared).
  extensionCount     Int              @default(0)
  highBidderId       String?
  highBidder         User?            @relation("ListingHighBidder", fields: [highBidderId], references: [id], onDelete: Restrict)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  images             ListingImage[]
  bids               Bid[]

  @@index([status, endsAt])
  @@index([sellerId])
  @@index([categoryId])
  @@index([highBidderId])
}

model ListingImage {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  pathname  String
  position  Int
  createdAt DateTime @default(now())

  @@unique([listingId, position])
}

// Every accepted bid. The unique key makes a retry harmless: the same bidder and key never place two bids.
model Bid {
  id             String   @id @default(cuid())
  listingId      String
  listing        Listing  @relation(fields: [listingId], references: [id], onDelete: Restrict)
  bidderId       String
  bidder         User     @relation(fields: [bidderId], references: [id], onDelete: Restrict)
  amountCents    Int
  idempotencyKey String
  ip             String?
  createdAt      DateTime @default(now())

  @@unique([bidderId, idempotencyKey])
  @@index([listingId, amountCents(sort: Desc)])
  @@index([bidderId])
}

enum BidOutcome {
  ACCEPTED
  REFUSED
}

// One row per bid attempt, accepted or refused, with who and from where. Plain ids and no relations, so deleting a
// listing or an account never erases the record.
model BidAudit {
  id          String     @id @default(cuid())
  userId      String?
  listingId   String?
  amountCents Int?
  ip          String?
  outcome     BidOutcome
  reason      String?
  createdAt   DateTime   @default(now())

  @@index([userId, createdAt])
  @@index([listingId, createdAt])
  @@index([ip, createdAt])
}

// An outbid email waiting to be sent, one per person and auction. Waiting lets a bidding war collapse into one email
// (or none, if they bid again or are watching); bidding again deletes the row. Plain ids and no relations, like BidAudit; a sweeper sends what is due.
model PendingOutbidEmail {
  id          String   @id @default(cuid())
  userId      String
  listingId   String
  dueAt       DateTime
  createdAt   DateTime @default(now())

  @@unique([userId, listingId])
  @@index([dueAt])
}
